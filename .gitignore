.env

# macOS / editors
.DS_Store
*.swp
.idea/
.vscode/

# Cover cache (refetchable from the catalogues)
cache/

# Screenshots produced by scripts/screenshots.mjs
screenshots/

# Desktop apps built by scripts/macos-app.sh, windows.sh and linux-app.sh
dist/
