# Copy this file to .env and set a strong password.
# It protects the whole application (librarian sign-in). At least 12 characters
# on a networked instance; a passphrase of three or four words is easy to keep.
BIBLI_ADMIN_PASSWORD=change-me-to-a-passphrase

# Optional: Google Books API key. Without one, enrichment stays rate-limited
# (429 errors when cataloguing many books in a row). Get a key at
# https://console.cloud.google.com/ (the "Books" API).
BIBLI_GOOGLE_BOOKS_KEY=
